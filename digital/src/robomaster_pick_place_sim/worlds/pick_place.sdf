<?xml version="1.0"?>
<sdf version="1.7">
  <world name="pick_place">
    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics" />
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands" />
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster" />
    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <gravity>0 0 -9.81</gravity>

    <scene>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.82 0.86 0.90 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <pose>0 0 6 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.4 0.3 -1</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <pose>0 0 -0.01 0 0 0</pose>
      <link name="ground_link">
        <collision name="collision">
          <geometry>
            <box>
              <size>4 4 0.02</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>4 4 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>0.82 0.82 0.80 1</ambient>
            <diffuse>0.84 0.84 0.82 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 分类区只有视觉，不增加碰撞；地面碰撞顶面仍严格为 z=0。 -->
    <model name="bottle_zone_marker">
      <static>true</static>
      <pose>0 -0.62 0.001 0 0 0</pose>
      <link name="marker_link">
        <visual name="marker_visual">
          <geometry><box><size>0.70 0.42 0.002</size></box></geometry>
          <material>
            <ambient>0.40 0.68 0.92 1</ambient>
            <diffuse>0.46 0.75 1.00 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="tennis_zone_marker">
      <static>true</static>
      <pose>0 0.62 0.001 0 0 0</pose>
      <link name="marker_link">
        <visual name="marker_visual">
          <geometry><box><size>0.70 0.42 0.002</size></box></geometry>
          <material>
            <ambient>0.50 0.86 0.58 1</ambient>
            <diffuse>0.56 0.94 0.64 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 六个中性命名任务物体由 spawn_sorting_scene.py 一次性生成。 -->
  </world>
</sdf>
