<?xml version="1.0"?>
<sdf version="1.7">
  <world name="pick_place">
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <gravity>0 0 -9.81</gravity>

    <scene>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.82 0.86 0.90 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <pose>0 0 6 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.4 0.3 -1</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <pose>0 0 -0.01 0 0 0</pose>
      <link name="ground_link">
        <collision name="collision">
          <geometry>
            <box>
              <size>4 4 0.02</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>4 4 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>0.78 0.78 0.78 1</ambient>
            <diffuse>0.78 0.78 0.78 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 桌面: 顶面高度 z = 0.30 -->

    <!-- 取物点 A 标记 (红色) -->

    <!-- 放置点 B 标记 (绿色) -->

    <!-- 两个动态任务物体由 grasp_bottle_tennis.py 按轮次生成。 -->
  </world>
</sdf>
