<?xml version="1.0" ?>
<sdf version="1.7">

  <model name="water_bottle_02">

    <static>false</static>

    <link name="bottle_link">

      <!-- Bottle center: half of 0.21 m -->
      <pose>0 0 0.105 0 0 0</pose>

      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.0019</ixx>
          <iyy>0.0019</iyy>
          <izz>0.0005</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <!-- Simple collision body for stable grasping -->
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.032</radius>
            <length>0.21</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>100.0</mu>
              <mu2>100.0</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>500000</kp>
              <kd>500</kd>
            </ode>
          </contact>
        </surface>
      </collision>

      <!-- Transparent bottle body -->
      <visual name="bottle_body_visual">

        <!-- The OBJ is ground-referenced (z=0..0.20), while bottle_link is
             centred at z=0.105 for the collision. Cancel the link offset so
             the rendered bottle rests on the ground with its collision. -->
        <pose>0 0 -0.105 0 0 0</pose>

        <geometry>
          <mesh>
            <uri>model://water_bottle_02/meshes/bottle_body.obj</uri>
          </mesh>
        </geometry>

        <material>
          <ambient>0.55 0.75 0.90 1</ambient>
          <diffuse>0.65 0.85 0.95 1</diffuse>
          <specular>0.9 0.9 0.9 1</specular>
        </material>

        <transparency>0.55</transparency>

      </visual>

      <!-- Blue bottle cap -->
      <visual name="bottle_cap_visual">

        <!-- The cap OBJ uses the same ground-referenced coordinates. -->
        <pose>0 0 -0.105 0 0 0</pose>

        <geometry>
          <mesh>
            <uri>model://water_bottle_02/meshes/bottle_cap.obj</uri>
          </mesh>
        </geometry>

        <material>
          <ambient>0.02 0.10 0.30 1</ambient>
          <diffuse>0.03 0.18 0.55 1</diffuse>
          <specular>0.35 0.35 0.35 1</specular>
        </material>

      </visual>

    </link>

  </model>

</sdf>
