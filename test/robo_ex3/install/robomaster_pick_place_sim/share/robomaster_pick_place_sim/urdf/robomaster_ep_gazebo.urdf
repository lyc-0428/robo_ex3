      </geometry>
    </visual>
    <visual name="armor">
      <origin xyz="-0.0065 -0.0781 0.0539" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robomaster_pick_place_sim/meshes/armor.dae" scale="1 1 1" />
      </geometry>
    </visual>
    <visual name="battery">
      <origin xyz="-0.1303 -0.0019 0.0420" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robomaster_pick_place_sim/meshes/battery.dae" scale="1 1 1" />
      </geometry>
    </visual>
    <visual name="battery_pin_left">
      <origin xyz="-0.1159 0.0661 0.0771" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robomaster_pick_place_sim/meshes/battery_pin_left.dae" scale="1 1 1" />
      </geometry>
    </visual>
    <visual name="battery_pin_right">
      <origin xyz="-0.1159 -0.0659 0.0771" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robomaster_pick_place_sim/meshes/battery_pin_right.dae" scale="1 1 1" />
