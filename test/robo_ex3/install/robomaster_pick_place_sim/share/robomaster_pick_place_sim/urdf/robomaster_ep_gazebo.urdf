<?xml version='1.0' encoding='utf-8'?>
<robot name="robomaster_ep_core">
  <link name="world" />
  <link name="base_link">
    <inertial>
      <mass value="6.0" />
      <origin xyz="0 0 0" />
      <inertia ixx="0.12" ixy="0" ixz="0" iyy="0.18" iyz="0" izz="0.22" />
    </inertial>
    <visual name="chassis">
      <origin xyz="-0.0059 0.0004 0.0774" rpy="0 0 0" />
